# ---------------------------------------------------------------------------
# Konfiguracja dla `docker compose` (cała aplikacja: Postgres + API + frontend).
# Skopiuj ten plik do .env i uzupełnij sekrety:
#   cp .env.example .env          (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Plik .env jest w .gitignore — nigdy nie commituj prawdziwych sekretów.
# ---------------------------------------------------------------------------

# --- Baza danych -----------------------------------------------------------
POSTGRES_USER=fiszki
POSTGRES_PASSWORD=zmien_to_na_silne_haslo
POSTGRES_DB=fiszki
# Port, na którym Postgres jest widoczny z hosta (tylko 127.0.0.1).
POSTGRES_PORT=5432

# --- Sekrety JWT -----------------------------------------------------------
# Wygeneruj dwie RÓŻNE, długie losowe wartości:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   openssl rand -hex 64
JWT_SECRET=zmien_to_na_dlugi_losowy_ciag
JWT_REFRESH_SECRET=zmien_to_na_inny_dlugi_losowy_ciag

# Czas życia tokenów dostępu i odświeżania.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Porty publikowane na hoście -------------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=8080

# --- Powiązanie frontendu z API --------------------------------------------
# VITE_API_URL jest wkompilowywane w bundle podczas builda obrazu frontendu,
# więc po jego zmianie trzeba przebudować: docker compose build frontend
# CORS_ORIGIN musi być dokładnym adresem, spod którego otwierasz frontend
# (bez ukośnika na końcu) — inaczej API odrzuci logowanie i zapisy.
#
# Lokalnie:
VITE_API_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:8080
# Na serwerze, np.:
# VITE_API_URL=https://api.twoja-domena.pl/api
# CORS_ORIGIN=https://twoja-domena.pl

# --- Limity bezpieczeństwa --------------------------------------------------
# Maks. NIEUDANYCH prób logowania/rejestracji z jednego IP na 15 minut.
AUTH_RATE_LIMIT_MAX=10

# --- Reverse proxy z HTTPS (opcjonalny profil "proxy") ---------------------
# Używane tylko przez `docker compose --profile proxy up -d`. Domena musi mieć
# rekord A wskazujący na serwer, a porty 80 i 443 muszą być wolne.
# Najprościej wygenerować cały ten plik na serwerze:
#   ./scripts/setup-env.sh --domain twoja-domena.pl
DOMAIN=localhost
# Adres do powiadomień Let's Encrypt o wygasających certyfikatach (opcjonalny).
ACME_EMAIL=

# --- Istniejący Traefik (nakładka docker-compose.traefik.yml) --------------
# Używane tylko przy:
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d
# Muszą dokładnie odpowiadać Twojej instancji Traefika.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
