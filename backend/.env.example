# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://fiszki:fiszki_password@localhost:5432/fiszki?schema=public

# Secrets used to sign JWTs. Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Access/refresh token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Origin(s) allowed to call the API (comma separated). Must match the frontend URL exactly.
CORS_ORIGIN=http://localhost:5173

# Port the Express server listens on
PORT=4000

# Max FAILED login/register attempts per IP per 15 minutes (successful ones
# never count). Defaults to 10 in production and 100 otherwise. Individual
# accounts are additionally locked for 15 min after 5 failed attempts.
AUTH_RATE_LIMIT_MAX=100

NODE_ENV=development
